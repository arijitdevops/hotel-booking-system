# Database ------------------------------------------------------------------
# SQLite file, relative to the backend/ directory. Created on first run.
DATABASE_FILE=./data/hotel.db

# Server --------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Authentication ------------------------------------------------------------
# Replace with a long random string before running anywhere but localhost.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# HTTP ----------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MINUTES=15

# Business rules ------------------------------------------------------------
TAX_PERCENT=12
FREE_CANCELLATION_HOURS=48
CANCELLATION_FEE_PERCENT=25
